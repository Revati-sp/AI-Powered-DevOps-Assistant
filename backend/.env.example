# =============================================================================
# Application
# =============================================================================
APP_NAME=AI-Powered DevOps Assistant
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true
OPENAPI_ENABLED=true

# =============================================================================
# Authentication & JWT
# =============================================================================
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_TOKEN_PEPPER=dev-refresh-pepper-default
JWT_ISSUER=ai-powered-devops-assistant
JWT_AUDIENCE=ai-powered-devops-assistant-api
JWT_ALGORITHM=HS256
JWT_CLOCK_SKEW_SECONDS=30

# =============================================================================
# Password policy
# =============================================================================
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_REJECT_COMMON=true
PASSWORD_BCRYPT_ROUNDS=12

# =============================================================================
# Email (local: Mailpit on :1025; staging/prod: Postmark SMTP)
# =============================================================================
EMAIL_ENABLED=false
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM_NAME=AI-Powered DevOps Assistant
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
EMAIL_REQUEST_TIMEOUT_SECONDS=30
EMAIL_MAX_RETRIES=2
EMAIL_LOG_BODIES=false
PASSWORD_RESET_TOKEN_MINUTES=60
EMAIL_VERIFICATION_TOKEN_MINUTES=1440
INVITATION_EXPIRE_HOURS=168
FRONTEND_BASE_URL=http://localhost:3000
# Optional alias for link generation (wins over FRONTEND_BASE_URL when set)
APP_PUBLIC_URL=

# =============================================================================
# Database & cache
# =============================================================================
# Host machine / local Alembic (service published on localhost:5432):
DATABASE_URL=postgresql+asyncpg://devops:devops@localhost:5432/devops_assistant
# Inside Docker Compose services, use the service hostname instead:
# DATABASE_URL=postgresql+asyncpg://devops:devops@db:5432/devops_assistant
# Managed providers (Render, etc.) often supply postgresql:// — the app normalizes
# that to postgresql+asyncpg:// automatically.
#
# Local defaults (dev only): user=devops password=devops db=devops_assistant
# POSTGRES_* init vars only apply to a NEW empty volume. If Alembic fails with
# "role devops does not exist", reset the volume or create the role — see docs/database.md
# MIGRATION_ENV=development
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Celery
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=540
CELERY_TASK_TIME_LIMIT_SECONDS=600
CELERY_RESULT_EXPIRES_SECONDS=3600
CELERY_MAX_RETRIES=3
BACKGROUND_TASK_RETENTION_DAYS=30

# =============================================================================
# LLM providers (default: gemini | llama | mistral)
# =============================================================================
LLM_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=60
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
ALLOW_INSECURE_LLM_HTTP=false
ALLOW_PRIVATE_LLM_NETWORKS=false
ALLOWED_LLM_HOSTS=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

LLAMA_API_KEY=
LLAMA_BASE_URL=https://api.llama.com/compat/v1
LLAMA_MODEL=llama-3.1-8b-instruct

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

CHAT_HISTORY_LIMIT=10
SSE_HEARTBEAT_INTERVAL_SECONDS=15

# =============================================================================
# HTTP / CORS / payload limits
# =============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000
MAX_UPLOAD_SIZE_MB=5
MAX_REQUEST_BODY_MB=10
MAX_JSON_BODY_SIZE_BYTES=10485760
MAX_LOG_TEXT_SIZE_BYTES=5242880
MAX_LOG_LINES=100000
MAX_FILENAME_LENGTH=255
MAX_ARTIFACT_CONTENT_SIZE_BYTES=1000000
BLOCK_ARTIFACT_SAVE_ON_CRITICAL_POLICY_FAILURE=true

# =============================================================================
# Security headers
# =============================================================================
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# =============================================================================
# Rate limiting (Redis sliding window)
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_LLM_PER_MINUTE=20
RATE_LIMIT_STREAM_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_REDIS_PREFIX=devops-assistant:rate-limit
RATE_LIMIT_FAIL_OPEN=true
TRUSTED_PROXY_COUNT=0
TRUSTED_PROXY_IPS=

# =============================================================================
# Observability
# =============================================================================
LOG_FORMAT=text
LOG_SERVICE_NAME=api
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-powered-devops-assistant
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLE_RATIO=0.1
OTEL_LOG_CORRELATION=true
OTEL_EXPORT_TIMEOUT_SECONDS=10

METRICS_ENABLED=true
METRICS_REQUIRE_AUTH=false
METRICS_ALLOWED_IPS=

# =============================================================================
# Provider routing
# =============================================================================
PROVIDER_CIRCUIT_REDIS_PREFIX=devops-assistant:circuit-breaker
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_RECOVERY_SECONDS=60
PROVIDER_CIRCUIT_STATE_TTL_SECONDS=3600

# =============================================================================
# Usage quotas
# =============================================================================
# Leave unset for no default personal quota (empty string is also accepted).
# USAGE_DEFAULT_DAILY_TOKEN_LIMIT=
# USAGE_DEFAULT_MONTHLY_TOKEN_LIMIT=
USAGE_ENFORCE_PERSONAL_QUOTAS=false
