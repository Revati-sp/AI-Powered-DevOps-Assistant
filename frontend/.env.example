# Browser-safe public variables (NEXT_PUBLIC_*)
NEXT_PUBLIC_APP_NAME=AI-Powered DevOps Assistant
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_DEFAULT_THEME=system
NEXT_PUBLIC_ENABLE_STORYBOOK=false

# Server-only (never expose to the browser)
# Used by Next.js BFF route handlers / server components.
# Inside Docker Compose, point this at the api service:
# INTERNAL_API_BASE_URL=http://api:8000
INTERNAL_API_BASE_URL=http://localhost:8000

# Cookie security (set true behind HTTPS in staging/production)
AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=.example.com

# Optional Playwright overrides (local / CI)
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_SKIP_WEBSERVER=1
